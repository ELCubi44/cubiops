{
  "name": "cubiops-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Web oficial de CubiOps",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:contact": "node --experimental-strip-types server/contact-api.ts",
    "build": "astro build",
    "build:contact": "esbuild server/contact-api.ts --bundle --platform=node --format=cjs --outfile=dist-server/contact-api.cjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "astro": "astro",
    "assets": "node scripts/prepare-assets.mjs",
    "verify": "npm run lint && npm run check && npm run test && npm run build"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^7.2.4",
    "nodemailer": "^7.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.33.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^6.4.17",
    "esbuild": "^0.25.9",
    "eslint": "^9.33.0",
    "eslint-plugin-astro": "^1.3.1",
    "sharp": "^0.34.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4"
  }
}
