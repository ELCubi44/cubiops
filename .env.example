# Sitio canónico
PUBLIC_SITE_URL=https://cubiops.com
PUBLIC_CONTACT_EMAIL=contacto@cubiops.com
PUBLIC_CONTACT_API_URL=/api/contact

# Analítica opcional sin cookies (Plausible u compatible).
# Déjalo vacío para no cargar ningún script de medición.
PUBLIC_PLAUSIBLE_DOMAIN=

# API de contacto (solo servidor, no commitear valores reales)
CONTACT_BIND_HOST=127.0.0.1
CONTACT_BIND_PORT=3017
CONTACT_ALLOWED_ORIGIN=https://cubiops.com

# SMTP Nominalia. Si falta cualquiera de estos campos, el formulario
# NO simulará un envío correcto. La contraseña no se sube a Git.
SMTP_HOST=authsmtp.securemail.pro
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contacto@cubiops.com
SMTP_PASS=
SMTP_FROM=CubiOps <contacto@cubiops.com>
CONTACT_TO=contacto@cubiops.com
