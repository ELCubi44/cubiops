---
import { Picture } from 'astro:assets';
import CubeMark from './CubeMark.astro';
import heroImage from '../assets/hero-connections.png';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy reveal">
      <p class="kicker">CubiOps · Web, apps y procesos</p>
      <h1 id="hero-title">Automatización útil para negocios reales.</h1>
      <p class="lede">
        Creo páginas web, aplicaciones y automatizaciones a medida para que
        autónomos y pequeñas empresas ahorren tiempo y trabajen con más claridad.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="#contacto">Cuéntame qué quieres automatizar</a>
        <a class="btn btn-secondary" href="#servicios">Descubre lo que puedo crear</a>
      </div>
      <p class="diff">
        Sin comerciales ni intermediarios. Hablas directamente con la persona que
        diseña, desarrolla y mantiene tu solución.
      </p>
      <div class="pills" aria-label="Qué construyo">
        <span class="pill">Web</span>
        <span class="pill">Apps</span>
        <span class="pill">Automatización</span>
      </div>
    </div>
    <div class="hero-visual reveal">
      <Picture
        src={heroImage}
        alt="Cubo geométrico abierto rodeado de líneas y nodos que representan procesos conectados."
        widths={[480, 720, 960, 1200]}
        sizes="(max-width: 860px) 100vw, 40vw"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
        quality={78}
      />
      <CubeMark class="hero-cube" />
    </div>
  </div>
</section>
