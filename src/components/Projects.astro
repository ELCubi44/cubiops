---
import { projects } from '../data/projects';
import { getPublishedProjects } from '../lib/projects';

const published = getPublishedProjects(projects);
---

<section class="section" id="proyectos" aria-labelledby="proyectos-title">
  <div class="wrap">
    <div class="section-head">
      <p class="kicker">Proyectos</p>
      <h2 id="proyectos-title">Trabajo real, en marcha.</h2>
      <p class="lede">Pulsa un logo para ver qué construí.</p>
    </div>

    <div class="case-logos">
      {published.map((project) => (
        <a class="case-logo" href={`/proyectos/${project.id}`} data-tilt>
          <span class="case-logo-frame">
            <img src={project.logo} alt="" width="112" height="112" />
          </span>
          <span class="case-logo-name">{project.clientName}</span>
          <span class="case-logo-hint">{project.summary}</span>
        </a>
      ))}
    </div>
  </div>
</section>
