---
import CubeMark from './CubeMark.astro';
import { footerNav, legalNav, site } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-grid">
    <div>
      <a class="logo" href="/">
        <CubeMark />
        <span>{site.name}</span>
      </a>
      <p style="margin-top: 0.9rem; max-width: 22rem;">
        Estudio independiente. Automatizo el trabajo repetitivo de pequeños negocios.
        Presupuesto gratis.
      </p>
    </div>
    <div>
      <h3>Navegación</h3>
      <ul>
        {footerNav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h3>Contacto y legal</h3>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {legalNav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a href="/encargado-tratamiento">Encargado del tratamiento</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <p>© {year} {site.name}. Estudio independiente.</p>
    <a class="version" href="/estado">v{site.version}</a>
  </div>
</footer>
