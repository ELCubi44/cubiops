---
const items = [
  'Webs claras',
  'Apps útiles',
  'Citas',
  'Facturas',
  'Agenda',
  'Reprosonic',
  'HAF Barber Shop',
  'Presupuesto gratis',
];
---

<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    {[...items, ...items].map((item) => (
      <span>{item}</span>
    ))}
  </div>
</div>
