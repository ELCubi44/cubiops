---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
import { canShowPublicly, canShowRating } from '../../lib/projects';

export function getStaticPaths() {
  return projects.filter(canShowPublicly).map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const showRating = canShowRating(project);
---

<BaseLayout
  title={project.title}
  description={project.problem}
  path={`/proyectos/${project.id}`}
  type="article"
>
  <section class="legal">
    <article class="wrap legal-card">
      <p class="kicker">{project.sector}</p>
      <h1>{project.title}</h1>
      <p class="eyebrow">{project.clientName}</p>
      <h2>Problema</h2>
      <p>{project.problem}</p>
      <h2>Solución</h2>
      <p>{project.solution}</p>
      {project.automations.length > 0 && (
        <>
          <h2>Automatizaciones</h2>
          <ul>
            {project.automations.map((item) => <li>{item}</li>)}
          </ul>
        </>
      )}
      <h2>Resultado</h2>
      <p>{project.result}</p>
      {project.technologies.length > 0 && (
        <>
          <h2>Tecnologías</h2>
          <p>{project.technologies.join(', ')}</p>
        </>
      )}
      {showRating && (
        <>
          <h2>Valoración</h2>
          <p aria-label={`Valoración ${project.rating} de 5`}>
            {'★'.repeat(project.rating ?? 0)}{'☆'.repeat(5 - (project.rating ?? 0))}
          </p>
          <blockquote>
            <p>{project.testimonial}</p>
            <footer>{project.reviewerName}{project.reviewerRole ? `, ${project.reviewerRole}` : ''}</footer>
          </blockquote>
        </>
      )}
      <p><a href="/#proyectos">Volver a proyectos</a></p>
    </article>
  </section>
</BaseLayout>
