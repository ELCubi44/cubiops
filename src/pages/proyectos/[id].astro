---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
import { canShowPublicly, canShowRating, workLabel } from '../../lib/projects';

export function getStaticPaths() {
  return projects.filter(canShowPublicly).map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const showRating = canShowRating(project);
---

<BaseLayout
  title={project.title}
  description={project.summary || project.problem}
  path={`/proyectos/${project.id}`}
  type="article"
  image={project.logo}
>
  <section class="case">
    <article class="wrap case-article">
      <p class="kicker">{project.sector}</p>
      <div class="case-hero">
        <div class="case-hero-copy">
          <h1>{project.clientName}</h1>
          <p class="lede">{project.summary}</p>
          {project.url && (
            <p>
              <a class="btn btn-primary" href={project.url} rel="noopener noreferrer" target="_blank">
                Visitar {project.url.replace(/^https:\/\//, '')}
              </a>
            </p>
          )}
        </div>
        <div class="case-hero-logo">
          <img src={project.logo} alt={project.logoAlt} width="320" height="320" />
        </div>
      </div>

      <h2>Qué hice</h2>
      <div class="case-works">
        {project.works.map((work) => (
          <article class="case-work">
            <p class="eyebrow">{workLabel(work.kind)}</p>
            {work.icon && (
              <img class="case-work-icon" src={work.icon} alt="" width="96" height="96" />
            )}
            <h3>{work.title}</h3>
            <p>{work.body}</p>
            {work.url && (
              <p>
                <a href={work.url} rel="noopener noreferrer" target="_blank">
                  {work.url.replace(/^https:\/\//, '')}
                </a>
              </p>
            )}
          </article>
        ))}
      </div>

      {showRating && (
        <>
          <h2>Valoración</h2>
          <p aria-label={`Valoración ${project.rating} de 5`}>
            {'★'.repeat(project.rating ?? 0)}{'☆'.repeat(5 - (project.rating ?? 0))}
          </p>
          <blockquote>
            <p>{project.testimonial}</p>
            <footer>
              {project.reviewerName}
              {project.reviewerRole ? `, ${project.reviewerRole}` : ''}
            </footer>
          </blockquote>
        </>
      )}

      <p class="case-back"><a href="/#proyectos">Volver a proyectos</a></p>
    </article>
  </section>
</BaseLayout>
