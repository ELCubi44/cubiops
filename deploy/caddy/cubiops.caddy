# CubiOps — sitio estático en /var/www/cubiops
# Insertado y actualizado por scripts/deploy-server.ps1
# BEGIN CUBIOPS
http://cubiops.com, http://www.cubiops.com, http://cubiops.es, http://www.cubiops.es {
	redir https://cubiops.com{uri} 308
}

www.cubiops.com, cubiops.es, www.cubiops.es {
	tls {
		issuer acme {
			preferred_chains {
				root_common_name "ISRG Root X1"
			}
		}
		key_type rsa2048
	}
	redir https://cubiops.com{uri} 308
}

https://cubiops.com {
	tls {
		issuer acme {
			preferred_chains {
				root_common_name "ISRG Root X1"
			}
		}
		key_type rsa2048
	}

	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	handle /api/contact {
		reverse_proxy 127.0.0.1:3017
	}

	handle {
		root * /var/www/cubiops
		try_files {path} {path}/index.html {path}.html /404.html
		file_server
	}

	handle_errors {
		root * /var/www/cubiops
		rewrite * /404.html
		file_server
	}
}
# END CUBIOPS
